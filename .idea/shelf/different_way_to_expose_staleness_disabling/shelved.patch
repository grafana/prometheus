+// DisableEndOfRunStalenessForTargets disables the end-of-run staleness markers for all the targets in tg. These should
+// be targets with the same labels that were previously passed to Run method. The corresponding ScrapeConfig is required
+// to populate the targets' labels, so they can be identified in the scrape pool.
+//
+// When the end-of-run staleness is disabled for a target, when it goes away, there will be no staleness markers written
+// for its series.
+//
+// No error is returned when provided targets are not found.
+func (m *Manager) DisableEndOfRunStalenessForTargets(targetSet string, tg *targetgroup.Group, cfg *config.ScrapeConfig) error {
+	if len(tg.Targets) == 0 {
+		return nil
+	}
+	targets := make([]*Target, 0, len(tg.Targets))
+	populatedTargets, errs := TargetsFromGroup(tg, cfg, targets, labels.NewBuilder(labels.EmptyLabels()))
+	if len(errs) > 0 {
+		return multierr.Combine(errs...)
+	}
+
+	// Only hold the lock to find the scrape pool
+	m.mtxScrape.Lock()
+	sp, ok := m.scrapePools[targetSet]
+	m.mtxScrape.Unlock()
+
+	if !ok {
+		return fmt.Errorf("target set not found: %q", targetSet)
+	}
+	return sp.disableEndOfRunStalenessMarkers(populatedTargets)
+}
