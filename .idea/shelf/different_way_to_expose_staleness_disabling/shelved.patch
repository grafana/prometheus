+	require.NoError(t, m.ApplyConfig(cfg))
+
+	// Pass targets to the manager.
+	tgs := map[string][]*targetgroup.Group{
+		"one": {{Targets: []model.LabelSet{{"__address__": "h1"}, {"__address__": "h2"}, {"__address__": "h3"}}}},
+		"two": {{Targets: []model.LabelSet{{"__address__": "h4"}}}},
+	}
+	m.updateTsets(tgs)
+	m.reload()
+
+	activeTargets := m.TargetsActive()
+	var expectedDisabled []string
+
+	// Disable end of run staleness markers for targets in group one
+	tg1 := &targetgroup.Group{
+		Source: "one",
+		Targets: []model.LabelSet{
+			{"__address__": "h1"},
+			{"__address__": "h3"},
+		},
+	}
+	expectedDisabled = append(expectedDisabled, []string{"http://h1/metrics", "http://h3/metrics"}...)
+	err = m.DisableEndOfRunStalenessForTargets(tg1, cfg.ScrapeConfigs[0])
+	require.NoError(t, err)
+
+	// Disable end of run staleness markers for targets in group two
+	tg2 := &targetgroup.Group{
+		Source: "two",
+		Targets: []model.LabelSet{
+			{"__address__": "h4"},
+		},
+	}
+	expectedDisabled = append(expectedDisabled, "http://h4/metrics")
+	err = m.DisableEndOfRunStalenessForTargets(tg2, cfg.ScrapeConfigs[1])
+	require.NoError(t, err)
+
+	// Test with non-existent target set
+	tgNonExistent := &targetgroup.Group{
+		Source: "non-existent",
+		Targets: []model.LabelSet{
+			{"__address__": "h5"},
+		},
+	}
+	err = m.DisableEndOfRunStalenessForTargets(tgNonExistent, cfg.ScrapeConfigs[0])
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "target set not found")
+
+	// Check that the end of run staleness markers are disabled for the correct targets.
+	for _, group := range []string{"one", "two"} {
+		for _, tg := range activeTargets[group] {
+			loop := m.scrapePools[group].loops[tg.hash()].(*scrapeLoop)
+			shouldBeDisabled := slices.Contains(expectedDisabled, tg.String())
+			require.Equal(t, shouldBeDisabled, loop.disabledEndOfRunStalenessMarkers, "expected disabled to be %v for target %s", shouldBeDisabled, tg.String())
+		}
+	}
+}
